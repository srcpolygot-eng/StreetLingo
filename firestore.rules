rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 60 &&
             data.activeCityId in ['paris', 'tokyo', 'madrid'] &&
             data.difficulty in ['beginner', 'intermediate', 'advanced'] &&
             data.preferredModel is string &&
             data.preferredModel.size() >= 1 &&
             data.preferredModel.size() <= 64 &&
             data.xp is int &&
             data.xp >= 0 &&
             data.xp <= 10000000 &&
             data.streakDays is int &&
             data.streakDays >= 0 &&
             data.streakDays <= 36500 &&
             (!('lastPracticeDate' in data) || (
               data.lastPracticeDate is string &&
               data.lastPracticeDate.size() <= 16 &&
               data.lastPracticeDate.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')
             )) &&
             data.completedNpcIds is list &&
             data.completedNpcIds.size() <= 30 &&
             (data.completedNpcIds.size() == 0 || data.completedNpcIds[0] is string) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidSavedPhrase(data, ownerUid) {
      return data.userId is string &&
             data.userId == ownerUid &&
             data.userId == request.auth.uid &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.cityId in ['paris', 'tokyo', 'madrid'] &&
             data.npcName is string &&
             data.npcName.size() >= 1 &&
             data.npcName.size() <= 60 &&
             data.targetText is string &&
             data.targetText.size() >= 1 &&
             data.targetText.size() <= 300 &&
             data.phonetic is string &&
             data.phonetic.size() <= 300 &&
             data.translation is string &&
             data.translation.size() >= 1 &&
             data.translation.size() <= 300 &&
             data.culturalNote is string &&
             data.culturalNote.size() <= 500 &&
             data.illustrationCommands is list &&
             data.illustrationCommands.size() <= 80 &&
             (data.illustrationCommands.size() == 0 || data.illustrationCommands[0] is string) &&
             data.masteryLevel is int &&
             data.masteryLevel >= 0 &&
             data.masteryLevel <= 5 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'activeCityId', 'difficulty',
                         'preferredModel', 'xp', 'streakDays', 'completedNpcIds',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'activeCityId', 'difficulty',
                         'preferredModel', 'xp', 'streakDays', 'lastPracticeDate',
                         'completedNpcIds', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'activeCityId', 'difficulty',
                         'preferredModel', 'xp', 'streakDays', 'lastPracticeDate',
                         'completedNpcIds', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /phrases/{phraseId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(phraseId) && request.auth.uid == userId;
        allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(phraseId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll([
                           'userId', 'cityId', 'npcName', 'targetText', 'phonetic',
                           'translation', 'culturalNote', 'illustrationCommands',
                           'masteryLevel', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'cityId', 'npcName', 'targetText', 'phonetic',
                           'translation', 'culturalNote', 'illustrationCommands',
                           'masteryLevel', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidSavedPhrase(incoming(), userId);

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(phraseId) &&
                         request.auth.uid == userId &&
                         isValidSavedPhrase(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'targetText', 'phonetic', 'translation', 'culturalNote',
                           'illustrationCommands', 'masteryLevel', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(phraseId) && request.auth.uid == userId;
      }
    }
  }
}
